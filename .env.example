# ---------------------------------------------------------------------------
# CardHawk configuration.  Copy to `.env` and fill in what you have.
# The app runs with NO credentials at all (fixture mode) so you can try it
# before signing up for anything.
# ---------------------------------------------------------------------------

# Where the API listens.  0.0.0.0 lets your phone reach it over your home wifi.
PORT=8787
HOST=0.0.0.0

# SQLite file. Relative paths resolve against the project root.
DATABASE_PATH=./data/cardhawk.db

# Currency + region used for price comparisons.
CURRENCY=USD
MARKETPLACE=EBAY_US

# Estimated sales tax added to landed cost when a source doesn't report tax.
# 0.07 = 7%.  Set to 0 to compare pre-tax prices.
EST_TAX_RATE=0.07

# --- eBay -------------------------------------------------------------------
# Free: https://developer.ebay.com/  ->  create an app  ->  "Production" keyset.
# You need the App ID (Client ID) and Cert ID (Client Secret).
# See docs/EBAY_SETUP.md for a click-by-click walkthrough.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" only if you know why you want it (sandbox has no real cards).
EBAY_ENV=production
# Optional eBay Partner Network campaign id; when set, listing links are
# rewritten as affiliate links.  Leave blank for plain links.
EBAY_EPN_CAMPAIGN_ID=

# --- PriceCharting (optional, paid) ----------------------------------------
# Gives real sold-comp values for graded/raw cards and sealed product, which
# makes market baselines far more accurate.  https://www.pricecharting.com/api
PRICECHARTING_TOKEN=

# --- Pokemon TCG API (optional, free key raises the rate limit) -------------
# https://pokemontcg.io/
POKEMONTCG_API_KEY=

# --- Alerts (all optional) --------------------------------------------------
# ntfy.sh push notifications to your phone: pick an unguessable topic name,
# install the ntfy app, subscribe to the same topic.  No account needed.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Generic webhook (Discord, Slack, Home Assistant, n8n...) receives a JSON POST
# for every new deal that clears the alert threshold.
ALERT_WEBHOOK_URL=

# Only alert on deals at least this far below the benchmark (percent).
ALERT_MIN_DISCOUNT_PCT=20

# --- Scanning ---------------------------------------------------------------
# Master switch for the background scheduler.  Set to false to only scan
# on demand from the UI or `npm run scan`.
SCHEDULER_ENABLED=true
# Don't let a runaway config burn your daily eBay API quota.
MAX_API_CALLS_PER_DAY=4500
