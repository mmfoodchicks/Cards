# CardLedger configuration. Everything has a working default — copy this to
# .env only if you want to change something.

# Where the app listens. 0.0.0.0 lets your phone reach it over your home wifi.
PORT=8420
HOST=0.0.0.0

# Your books. A single SQLite file; back it up by copying it.
DATABASE_PATH=./data/cardledger.db
BACKUPS_DIR=./backups
RECEIPTS_DIR=./data/receipts

# Back up on every startup, keeping the last 30. Cheap insurance.
BACKUP_ON_START=true

# The tax year the app works in. Defaults to the current year.
# TAX_YEAR=2026

# LOG_LEVEL=info
